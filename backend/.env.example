# ConstructGuard AI — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to GitHub

# ──────────────────────────────────────────
# REQUIRED
# ──────────────────────────────────────────

# Anthropic Claude (for Action Agent + fallback)
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ──────────────────────────────────────────
# GEMMA 4 — Pick ONE provider
# ──────────────────────────────────────────

# Which provider to use: google | ollama | groq
GEMMA_PROVIDER=google

# Option A: Google AI Studio (recommended to start — free tier available)
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIzaSy-xxxxx

# Option B: Ollama (local, free, private — best for production)
# Install Ollama: https://ollama.com
# Then: ollama pull gemma3:27b
# Then: ollama serve
OLLAMA_URL=http://localhost:11434

# Option C: Groq (fast cloud, has free tier)
# Sign up: https://console.groq.com
GROQ_API_KEY=gsk_xxxxx

# ──────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────
# DATABASE (add later with Supabase)
# ──────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/constructguard

# ──────────────────────────────────────────
# FILE STORAGE (add later)
# ──────────────────────────────────────────
# CLOUDINARY_URL=cloudinary://key:secret@cloud
